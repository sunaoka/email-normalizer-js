{
  "name": "@sunaoka/email-normalizer",
  "version": "0.2.0",
  "description": "Normalize email addresses using mailbox provider specific rules.",
  "type": "module",
  "license": "BSD-3-Clause",
  "author": "sunaoka <sunaoka@pocari.org>",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "ci": "run-p ci:*",
    "ci:lint": "eslint",
    "ci:format": "prettier --write src tests eslint.config.ts vitest.config.ts",
